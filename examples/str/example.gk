use "str"

putln(str.replace("hello, world!", "world!", "sailor!"))
putln(str.chars("hello, world!").to_string())
putln(str.split("a|b|c", "|").to_string())
putln(str.contains("abc", "a"))
putln(str.contains("abc", "d"))
putln(str.starts_with("abc", "a"))
putln(str.ends_with("abc", "a"))
putln(str.ends_with("abc", "a"))
putln(str.trim("   abc   "))
putln(str.trim_start("abc   "))
putln(str.trim_end("       abc"))
putln(str.strip_prefix("a:b", "a:"))
putln(str.strip_suffix("a:b", ":b"))
putln(str.to_upper("hello!"))
putln(str.to_lower("HELLO!"))
putln(str.matches("HELLO!", "L"))
putln(str.repeat("zzz... ", 5))
