#[ A tractor 🚜 ]#
class Tractor {
  # Init called when a Tractor called
  fun init(self, start_fuel) {
    self.fuel := start_fuel
  }
  # Does some work
  fun work(self) {
    if self.fuel >= 100 {
      self.fuel -= 100
      return "Tractor did some work"
    } else {
      return "Tractor fuel underflow"
    }
  }
  # Fills a fuel
  fun fill(self, fuel) {
    self.fuel += fuel
  }
}
# Calling tractor
tractor := Tractor(100)
putln(tractor.work())
putln(tractor.work())
tractor.fill(600)
putln(tractor.work())
